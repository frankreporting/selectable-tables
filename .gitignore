# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Test bundles (npm test)
.test-build

# The test vault's own state, and the plugin build copied into it (npm run test-vault)
test-vault/*/.obsidian/*
!test-vault/*/.obsidian/app.json
!test-vault/*/.obsidian/community-plugins.json
